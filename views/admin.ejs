<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Ayurveda Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        :root {
            --primary-color: #3a5a40;
            --secondary-color: #588157;
            --light-bg: #f8f9fa;
            --dark-text: #212529;
        }
        
        body {
            background-color: #f5f5f5;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        .sidebar {
            background-color: var(--primary-color);
            color: white;
            height: 100vh;
            position: fixed;
            width: 250px;
            padding-top: 20px;
        }
        
        .main-content {
            margin-left: 250px;
            padding: 20px;
        }
        
        .card {
            border-radius: 10px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            margin-bottom: 20px;
            border: none;
        }
        
        .card-header {
            background-color: var(--primary-color);
            color: white;
            border-radius: 10px 10px 0 0 !important;
            font-weight: 600;
        }
        
        .table-responsive {
            border-radius: 10px;
            overflow: hidden;
        }
        
        .table thead {
            background-color: var(--primary-color);
            color: white;
        }
        
        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
        
        .btn-primary:hover {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
        }
        
        .nav-link {
            color: rgba(255, 255, 255, 0.8);
            padding: 10px 15px;
            margin: 5px 0;
            border-radius: 5px;
        }
        
        .nav-link:hover, .nav-link.active {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
        }
        
        .nav-link i {
            margin-right: 10px;
        }
        
        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
        }
        
        .status-badge {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 500;
        }
        
        .badge-approved {
            background-color: #d4edda;
            color: #155724;
        }
        
        .badge-pending {
            background-color: #fff3cd;
            color: #856404;
        }
        
        .badge-rejected {
            background-color: #f8d7da;
            color: #721c24;
        }
        
        .action-btn {
            width: 30px;
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
        }
        
        .thumbnail {
            width: 50px;
            height: 50px;
            object-fit: cover;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="text-center mb-4">
            <h4>Ayurveda Admin</h4>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link active" href="#">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#doctor-applications">
                    <i class="bi bi-people-fill"></i> Doctor Applications
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#users">
                    <i class="bi bi-person-lines-fill"></i> Users
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#products">
                    <i class="bi bi-capsule"></i> Products
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#courses">
                    <i class="bi bi-book-half"></i> Courses
                </a>
            </li>
            <li class="nav-item mt-4">
                <a class="nav-link" href="/logout">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        <% if (messages.success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= messages.success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
        
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0">Dashboard Overview</h2>
            <div class="d-flex align-items-center">
                <img src="/assets/admin-avatar.png" alt="Admin" class="user-avatar me-2">
                <span>Welcome, <strong>Admin</strong></span>
            </div>
        </div>

        <!-- Doctor Applications Section -->
        <div class="card mb-4" id="doctor-applications">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Doctor Applications</h5>
                <span class="badge bg-light text-dark"><%= applications.length %> pending</span>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Doctor</th>
                                <th>Contact</th>
                                <th>Documents</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% applications.forEach((app, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="/image/<%= app.image %>" alt="<%= app.fullName %>" class="thumbnail me-2">
                                            <div>
                                                <strong><%= app.fullName %></strong><br>
                                                <small class="text-muted">Applied: <%= new Date(app.createdAt).toLocaleDateString() %></small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <%= app.email %><br>
                                        <small class="text-muted"><%= app.phone %></small>
                                    </td>
                                    <td>
                                        <a href="/resume/<%= app.resume %>" class="btn btn-sm btn-outline-primary" target="_blank">
                                            <i class="bi bi-file-earmark-pdf"></i> Resume
                                        </a>
                                    </td>
                                    <td>
                                        <% if (app.status === 'Pending') { %>
                                            <span class="status-badge badge-pending">Pending Review</span>
                                        <% } else if (app.status === 'Approved') { %>
                                            <span class="status-badge badge-approved">Approved</span>
                                        <% } else { %>
                                            <span class="status-badge badge-rejected">Rejected</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (app.status === 'Pending') { %>
                                            <form action="/admin/applications/<%= app._id %>/approve" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-success btn-sm action-btn" title="Approve">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <form action="/admin/applications/<%= app._id %>/reject" method="POST" class="d-inline">
                                                <button type="submit" class="btn btn-danger btn-sm action-btn" title="Reject">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        <% } else { %>
                                            <button class="btn btn-secondary btn-sm action-btn" disabled>
                                                <i class="bi bi-check2-all"></i>
                                            </button>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Registered Users Section -->
        <div class="card mb-4" id="users">
            <div class="card-header">
                <h5 class="mb-0">Registered Users</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>User</th>
                                <th>Email</th>
                                <th>Joined</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach((user, index) => { %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                            <div class="ms-2">
                                                <strong><%= user.fullName %></strong>
                                            </div>
                                        </div>
                                    </td>
                                    <td><%= user.email %></td>
                                    <td><%= new Date(user.createdAt).toLocaleDateString() %></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary action-btn" title="View">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger action-btn" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Add New Product Section -->
        <div class="card mb-4" id="products">
            <div class="card-header">
                <h5 class="mb-0">Add New Product</h5>
            </div>
            <div class="card-body">
                <form action="/upload-product" method="POST" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="name" class="form-label">Product Name</label>
                                <input type="text" class="form-control" id="name" name="name" required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="category" class="form-label">Category</label>
                                <select class="form-select" id="category" name="category" required>
                                    <option value="">Select Category</option>
                                    <option value="Herbal">Herbal</option>
                                    <option value="Supplement">Supplement</option>
                                    <option value="Oil">Oil</option>
                                    <option value="Powder">Powder</option>
                                </select>
                            </div>
                            
                            <div class="mb-3">
                                <label for="price" class="form-label">Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" step="0.01" class="form-control" id="price" name="price" required>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="stock" class="form-label">Stock Quantity</label>
                                <input type="number" class="form-control" id="stock" name="stock" required>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="productImage" class="form-label">Product Image</label>
                                <input type="file" class="form-control" id="productImage" name="productImage" accept="image/*">
                                <small class="text-muted">Recommended size: 500x500px</small>
                            </div>
                            
                            <div class="mb-3">
                                <label for="ingredients" class="form-label">Ingredients</label>
                                <textarea class="form-control" id="ingredients" name="ingredients" rows="2"></textarea>
                                <small class="text-muted">Separate with commas</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="description" rows="3" required></textarea>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="benefits" class="form-label">Health Benefits</label>
                                <textarea class="form-control" id="benefits" name="benefits" rows="2"></textarea>
                                <small class="text-muted">Separate with commas</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="usageInstructions" class="form-label">Usage Instructions</label>
                                <textarea class="form-control" id="usageInstructions" name="usageInstructions" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                    
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-plus-circle"></i> Add Product
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Add New Course Section -->
        <div class="card" id="courses">
            <div class="card-header">
                <h5 class="mb-0">Add New Course</h5>
            </div>
            <div class="card-body">
                <form action="/upload-course" method="POST" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="title" class="form-label">Course Title</label>
                                <input type="text" class="form-control" id="title" name="title" required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="price" class="form-label">Price</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input type="number" step="0.01" class="form-control" id="price" name="price" required>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <label for="fullVideo" class="form-label">Full Video</label>
                                <input type="file" class="form-control" id="fullVideo" name="fullVideo" accept="video/*" required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="fullVideoDuration" class="form-label">Full Video Duration (minutes)</label>
                                <input type="number" class="form-control" id="fullVideoDuration" name="fullVideoDuration" required>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="previewVideo" class="form-label">Preview Video</label>
                                <input type="file" class="form-control" id="previewVideo" name="previewVideo" accept="video/*" required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="previewVideoDuration" class="form-label">Preview Duration (minutes)</label>
                                <input type="number" class="form-control" id="previewVideoDuration" name="previewVideoDuration" required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="thumbnail" class="form-label">Course Thumbnail</label>
                                <input type="file" class="form-control" id="thumbnail" name="thumbnail" accept="image/*">
                                <small class="text-muted">Recommended size: 800x450px</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="description" class="form-label">Course Description</label>
                        <textarea class="form-control" id="description" name="description" rows="4" required></textarea>
                    </div>
                    
                    <div class="text-end">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-plus-circle"></i> Add Course
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Auto-dismiss alerts after 5 seconds
        setTimeout(() => {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                new bootstrap.Alert(alert).close();
            });
        }, 5000);
        
        // Format duration fields
        document.getElementById('fullVideoDuration').addEventListener('change', function() {
            this.value = Math.max(1, Math.floor(this.value));
        });
        
        document.getElementById('previewVideoDuration').addEventListener('change', function() {
            this.value = Math.max(1, Math.min(10, Math.floor(this.value)));
        });
    </script>
</body>
</html>