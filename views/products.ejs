<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>
    <link rel="stylesheet" href="css/product.css">
</head>
<body>
    <!-- Header Section -->
    <div class="header">
        <%- include('partials/nav') %>
    </div>

    <!-- Main Content -->
    <main class="products-main">
        <h1 class="page-title">All Products</h1>
        <div class="product-container">
            <% products.forEach(product => { %>
                <div class="product-card">
                    <div class="product-image">
                        <% if (product.image) { %>
                            <img src="/image/<%= product.image %>" alt="<%= product.name %>" class="product-img">
                        <% } else { %>
                            <p class="no-image">No image available</p>
                        <% } %>
                    </div>
                    <div class="product-details">
                        <h2 class="product-name"><%= product.name %></h2>
                        <p class="product-description"><%= product.description %></p>
                        <div class="product-meta">
                            <p><strong>Price:</strong> $<%= product.price %></p>
                            <p><strong>Category:</strong> <%= product.category %></p>
                            <p><strong>Stock:</strong> <%= product.stock %></p>
                        </div>
                        <button class="btn btn-primary" onclick="redirectToDummyPayment('<%= product.name %>',' <%= product.price %>')">Buy Now</button>
                    </div>
                </div>
            <% }) %>
        </div>
    </main>

    <!-- Footer Section -->
    <footer class="footer">
        <p>&copy; 2025 Ayurvedic Website. All rights reserved.</p>
    </footer>

    <script>
        function redirectToDummyPayment(productName, price) {
            window.location.href = `/payment?product=${encodeURIComponent(productName)}&price=${price}`;
        }
    </script>

</body>
</html>
