<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ayurveda Doctor Job | Ayurvedic Wellness</title>
    <link rel="stylesheet" href="css/doctorapply.css">
    <link rel="stylesheet" href="/css/nav.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="header">
    <%- include('partials/nav') %>
</div>

<header class="job-header">
    <div class="container">
        <h1>Ayurveda Doctor</h1>
        <p>Join our expert team and help patients experience holistic healing!</p>
    </div>
</header>

<section class="job-details container">
    <div class="row">
        <div class="col-md-8">
            <h2>Job Description</h2>
            <p>We are looking for a certified Ayurveda Doctor to provide consultations, recommend personalized treatments, and guide patients on holistic wellness.</p>

            <h3>Responsibilities</h3>
            <ul>
                <li>Provide expert Ayurvedic consultations.</li>
                <li>Prescribe personalized treatments and lifestyle plans.</li>
                <li>Educate patients on holistic healing approaches.</li>
                <li>Stay updated with Ayurvedic research and developments.</li>
            </ul>

            <h3>Requirements</h3>
            <ul>
                <li>Degree in Ayurvedic Medicine (BAMS, MD-Ayurveda preferred).</li>
                <li>Minimum 2 years of experience in clinical practice.</li>
                <li>Excellent communication and diagnostic skills.</li>
                <li>Passion for holistic healing and patient care.</li>
            </ul>

            <h3>Benefits</h3>
            <ul>
                <li>Competitive salary</li>
                <li>Flexible work hours</li>
                <li>Comprehensive health benefits</li>
                <li>Career growth opportunities</li>
            </ul>

            <a href="#apply-form" class="btn btn-primary apply-btn">Apply Now</a>
        </div>

        <div class="col-md-4">
            <div class="job-sidebar">
                <h4>Job Details</h4>
                <p><strong>Location:</strong> Kitchener, Canada</p>
                <p><strong>Job Type:</strong> Full-Time</p>
                <p><strong>Salary:</strong> $70,000 - $90,000 per year</p>
                <p><strong>Experience:</strong> 2+ years</p>
                <p><strong>Posted On:</strong> March 2025</p>
            </div>
        </div>
    </div>
</section>

<section class="apply-form container" id="apply-form">
    <h2>Apply for the Ayurveda Doctor Position</h2>
    <form action="/applyDoctor" method="POST" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="fullName" class="form-label">Full Name</label>
            <input type="text" id="fullName" name="fullName" class="form-control" required>
        </div>

        <div class="mb-3">
            <label for="email" class="form-label">Email Address</label>
            <input type="email" id="email" name="email" class="form-control" required>
        </div>

        <div class="mb-3">
            <label for="phone" class="form-label">Phone Number</label>
            <input type="tel" id="phone" name="phone" class="form-control" required>
        </div>

        <div class="mb-3">
            <label for="resume" class="form-label">Upload Resume</label>
            <input type="file" id="resume" name="resume" class="form-control" accept=".pdf,.doc,.docx" required>
        </div>

        <div class="mb-3">
            <label for="photo" class="form-label">Upload Your Photo</label>
            <input type="file" id="image" name="image" class="form-control" accept="image/*" required>
        </div>

        <!-- New Input Fields -->
    
     
        <div class="mb-3">
            <label for="educationQualification" class="form-label">Education Qualification</label>
            <div>
                <input type="checkbox" name="educationQualification" value="BAMS" id="BAMS"> BAMS<br>
                <input type="checkbox" name="educationQualification" value="BHMS" id="BHMS"> BHMS<br>
                <input type="checkbox" name="educationQualification" value="MD Ayurveda" id="MD-Ayurveda"> MD Ayurveda<br>
                <input type="checkbox" name="educationQualification" value="BDS" id="BDS"> BDS<br>
                <input type="checkbox" name="educationQualification" value="other" id="otherQualification" onclick="toggleOtherQualification()"> Other<br>
            </div>
            <div id="otherQualificationBox" style="display:none;">
                <label for="otherQualificationDetails" class="form-label">Please specify your qualification:</label>
                <input type="text" id="otherQualificationDetails" name="otherQualificationDetails" class="form-control">
            </div>
        </div>
        
        <div class="mb-3">
            <label for="experience" class="form-label">Professional Experience (in years)</label>
            <input type="text" id="experience" name="experience" class="form-control">
        </div>

        <div class="mb-3">
            <label for="skills" class="form-label">Skills (Comma Separated)</label>
            <input type="text" id="skills" name="skills" class="form-control" placeholder="e.g., Patient Care, Ayurvedic Treatments">
        </div>

        <div class="mb-3">
            <label for="dateOfBirth" class="form-label">Date of Birth</label>
            <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-control">
        </div>

        <div class="mb-3">
            <label for="message" class="form-label">Why do you want to join us?</label>
            <textarea id="message" name="message" class="form-control" rows="4" required></textarea>
        </div>

        <button type="submit" class="btn btn-success">Submit Application</button>
    </form>
</section>

<footer class="footer">
    <p>&copy; 2025 Ayurvedic Wellness | <a href="/privacy">Privacy Policy</a></p>
</footer>

</body>
</html>
<script>
    function toggleOtherQualification() {
        const otherQualificationBox = document.getElementById("otherQualificationBox");
        const otherQualification = document.getElementById("otherQualification");

        // Show the text box if "Other" checkbox is selected, otherwise hide it
        if (otherQualification.checked) {
            otherQualificationBox.style.display = "block";
        } else {
            otherQualificationBox.style.display = "none";
        }
    }
</script>