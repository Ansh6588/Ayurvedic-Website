<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking Confirmation | Ayurveda Wellness</title>
    <link rel="stylesheet" href="/css/success.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <div class="header">
        <%- include('partials/nav') %>
        <div class="login-register">
            <% if (user) { %>
                <span class="welcome-text">Welcome, <%= user.name %>!</span>
                <a href="/logout" class="btn-logout">Logout</a>
            <% } else { %>
                <a href="#" data-bs-toggle="modal" data-bs-target="#loginModal" class="btn-login">Login</a>
                <a href="/register" class="btn-register">Register</a>
            <% } %>
        </div>  
    </div>

    <div class="confirmation-hero">
        <div class="container">
            <div class="hero-content text-center">
                <h1>Your Consultation is Booked!</h1>
                <p class="lead">We've sent the appointment details to your email</p>
            </div>
        </div>
    </div>

    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="confirmation-card">
                    <div class="confirmation-header">
                        <div class="confirmation-icon">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <h2>Appointment Confirmation</h2>
                        <p class="confirmation-number">
                            Reference #<%= booking ? booking._id.toString().slice(-8).toUpperCase() : 'N/A' %>
                        </p>                    
                    </div>

                    <div class="confirmation-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-section">
                                    <h3><i class="fas fa-user me-2"></i>Your Details</h3>
                                    <ul class="info-list">
                                        <li><strong>Name:</strong> <%= booking.patientName %></li>
                                        <li><strong>Email:</strong> <%= booking.patientEmail %></li>
                                        <li><strong>Phone:</strong> <%= booking.patientPhone %></li>
                                        <li><strong>DOB:</strong> <%= new Date(booking.patientDOB).toLocaleDateString() %></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-section">
                                    <h3><i class="fas fa-clock me-2"></i>Appointment</h3>
                                    <ul class="info-list">
                                        <li><strong>Date & Time:</strong> <%= new Date(booking.appointmentDateTime).toLocaleString() %></li>
                                        <li><strong>Type:</strong> <%= booking.consultationType %></li>
                                        <li><strong>Duration:</strong> 45 minutes</li>
                                        <li><strong>Status:</strong> <span class="badge bg-success">Confirmed</span></li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <div class="doctor-details mt-4">
                            <h3><i class="fas fa-user-md me-2"></i>Your Ayurvedic Practitioner</h3>
                            <% if (doctor) { %>
                                <div class="doctor-card selected">
                                    <div class="doctor-image">
                                        <img src="/image/<%= doctor.image || 'default-doctor.jpg' %>" alt="Dr. <%= doctor.fullName %>" class="img-fluid">
                                    </div>
                                    <div class="doctor-info">
                                        <h4>Dr. <%= doctor.fullName %></h4>
                                        <div class="doctor-specialty">
                                            <i class="fas fa-graduation-cap"></i> 
                                            <%= doctor.educationQualification ? doctor.educationQualification.join(', ') : 'Ayurvedic Specialist' %>
                                        </div>
                                        <% if (doctor.bio) { %>
                                            <div class="doctor-bio mt-2">
                                                <p><%= doctor.bio %></p>
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% } else { %>
                                <div class="alert alert-warning">Practitioner information not available</div>
                            <% } %>
                        </div>

                        <div class="health-concerns mt-4">
                            <h3><i class="fas fa-heartbeat me-2"></i>Your Health Concerns</h3>
                            <div class="concerns-content">
                                <p><%= booking.healthConcerns %></p>
                            </div>
                        </div>
                    </div>

                    <div class="confirmation-footer">
                        <div class="confirmation-actions">
                            <a href="/consultation" class="btn btn-primary">
                                <i class="fas fa-calendar-plus me-2"></i> Book Another Appointment
                            </a>
                            <a href="#" class="btn btn-outline-secondary">
                                <i class="fas fa-download me-2"></i> Download Details
                            </a>
                        </div>
                        <div class="confirmation-note mt-3">
                            <p class="text-muted">
                                <i class="fas fa-info-circle me-2"></i>
                                You'll receive a reminder 24 hours before your appointment. 
                                Please arrive 10 minutes early for your consultation.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <h3>Ayurveda Wellness</h3>
                    <p>Holistic healing for mind, body and spirit</p>
                </div>
                <div class="footer-links">
                    <ul>
                        <li><a href="/about">About Us</a></li>
                        <li><a href="/services">Services</a></li>
                        <li><a href="/practitioners">Practitioners</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-social">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 Ayurveda Wellness Center. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>