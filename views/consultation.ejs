<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ayurvedic Consultation | Wellness Center</title>
    <link rel="stylesheet" href="/css/consultation.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <div class="header">
        <%- include('partials/nav') %>
        <div class="login-register">
            <% if (user) { %>
                <span class="welcome-text">Welcome, <%= user.name %>!</span>
                <a href="/logout" class="btn-logout">Logout</a>
            <% } else { %>
                <a href="#" data-bs-toggle="modal" data-bs-target="#loginModal" class="btn-login">Login</a>
                <a href="/register" class="btn-register">Register</a>
            <% } %>
        </div>  
    </div>

    <div class="hero-section">
        <div class="container">
            <div class="hero-content">
                <h1>Personalized Ayurvedic Consultation</h1>
                <p class="lead">Experience holistic healing with our certified Ayurvedic practitioners</p>
                <div class="hero-cta">
                    <a href="#consultation-types" class="btn btn-primary btn-lg">Book Now</a>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">Login to Your Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/login" method="POST">
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label">Email address</label>
                            <input type="email" class="form-control" id="loginEmail" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="loginPassword" class="form-label">Password</label>
                            <input type="password" class="form-control" id="loginPassword" name="password" required>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe">
                                <label class="form-check-label" for="rememberMe">Remember me</label>
                            </div>
                            <a href="#" class="text-decoration-none">Forgot password?</a>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Login</button>
                    </form>
                    <div class="text-center mt-3">
                        <p>Don't have an account? <a href="/register" class="text-decoration-none">Register here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container consultation-container">
        <div class="row g-4">
            <!-- Left Section: Consultation Types -->
            <div class="col-lg-4" id="consultation-types">
                <div class="consultation-section">
                    <h2 class="section-title"><i class="fas fa-spa me-2"></i>Consultation Types</h2>
                    <div class="section-description">Select the type of consultation that matches your needs</div>
                    
                    <% let consultationTypes = [
                        { name: "General Consultation", price: 50, icon: "user-md", description: "Comprehensive health assessment and lifestyle recommendations" },
                        { name: "Eye Consultation", price: 60, icon: "eye", description: "Specialized care for eye health and vision improvement" },
                        { name: "Skin Consultation", price: 70, icon: "hand-holding-medical", description: "Natural solutions for skin conditions and beauty" }
                    ]; %>

                    <div class="consultation-options">
                        <% consultationTypes.forEach((type, index) => { %>
                            <div class="consultation-card">
                                <div class="consultation-icon">
                                    <i class="fas fa-<%= type.icon %>"></i>
                                </div>
                                <div class="consultation-details">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h5 class="consultation-name"><%= type.name %></h5>
                                        <span class="consultation-price">$<%= type.price %></span>
                                    </div>
                                    <p class="consultation-description"><%= type.description %></p>
                                    <div class="form-check">
                                        <input class="form-check-input consultation-checkbox" type="radio" name="consultationType" value="<%= type.name %>" id="consultation-<%= index %>" required>
                                        <label class="form-check-label" for="consultation-<%= index %>">Select this option</label>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>

            <!-- Middle Section: Booking Form -->
            <div class="col-lg-4">
                <div class="booking-section">
                    <h2 class="section-title"><i class="fas fa-calendar-check me-2"></i>Appointment Details</h2>
                    
                    <% if (!user) { %>
                        <div class="alert alert-warning d-flex align-items-center">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <div>You are not signed in. <a href="/login" class="alert-link">Sign in</a> or fill in the details below.</div>
                        </div>
                    <% } else { %>
                        <div class="alert alert-success d-flex align-items-center">
                            <i class="fas fa-check-circle me-2"></i>
                            <div>Signed in as <strong><%= user.name %></strong>.</div>
                        </div>
                    <% } %>

                    <form action="/consultation/book" method="POST" class="booking-form" id="consultationForm">
                        <input type="hidden" name="selectedDoctor" id="selectedDoctor">
                        <input type="hidden" name="consultationType" id="consultationTypeHidden">
                        
                        <% if (!user) { %>
                            <div class="mb-3">
                                <label for="full-name" class="form-label">Full Name</label>
                                <input type="text" class="form-control" id="full-name" name="full_name" required>
                            </div>
                            <div class="mb-3">
                                <label for="email" class="form-label">Email Address</label>
                                <input type="email" class="form-control" id="email" name="email" required>
                            </div>
                        <% } else { %>
                            <input type="hidden" name="full_name" value="<%= user.name %>">
                            <input type="hidden" name="email" value="<%= user.email %>">
                        <% } %>
                        
                        <div class="mb-3">
                            <label for="phone" class="form-label">Phone Number</label>
                            <input type="tel" class="form-control" id="phone" name="phone" required>
                        </div>
                        <div class="mb-3">
                            <label for="dob" class="form-label">Date of Birth</label>
                            <input type="date" class="form-control" id="dob" name="dob" required>
                        </div>
                        <div class="mb-3">
                            <label for="concerns" class="form-label">Health Concerns</label>
                            <textarea class="form-control" id="concerns" name="concerns" rows="3" required placeholder="Describe your health concerns..."></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="appointment" class="form-label">Preferred Date & Time</label>
                            <input type="datetime-local" class="form-control" id="appointment" name="appointment" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100 btn-book">
                            <i class="fas fa-calendar-plus me-2"></i>Book Consultation
                        </button>
                    </form>
                </div>
            </div>

            <!-- Right Section: Available Doctors -->
            <div class="col-lg-4">
                <div class="doctors-section">
                    <h2 class="section-title"><i class="fas fa-user-md me-2"></i>Our Practitioners</h2>
                    <div class="section-description">Select your preferred Ayurvedic doctor</div>

                    <% if (approvedDoctors && approvedDoctors.length > 0) { %>
                        <div class="doctor-list">
                            <% approvedDoctors.forEach((doctor) => { %>
                                <div class="doctor-card" data-doctor-id="<%= doctor._id %>">
                                    <div class="doctor-image">
                                        <img src="/image/<%= doctor.image %>" alt="Dr. <%= doctor.fullName %>" class="img-fluid">
                                    </div>
                                    <div class="doctor-info">
                                        <div class="form-check">
                                            <input type="radio" name="doctor" value="<%= doctor._id %>" class="form-check-input doctor-checkbox" id="doctor-<%= doctor._id %>" required>
                                            <label class="form-check-label" for="doctor-<%= doctor._id %>"></label>
                                        </div>
                                        <h5 class="doctor-name">Dr. <%= doctor.fullName %></h5>
                                        <div class="doctor-specialty">
                                            <% if (doctor.educationQualification && doctor.educationQualification.length > 0) { %>
                                                <i class="fas fa-graduation-cap"></i> <%= doctor.educationQualification.join(', ') %>
                                            <% } %>
                                        </div>
                                        <div class="doctor-actions">
                                            <button type="button" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-phone-alt"></i> Call
                                            </button>
                                            <button type="button" class="btn btn-outline-success btn-sm">
                                                <i class="fas fa-video"></i> Video
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i> No doctors available at the moment. Please check back later.
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <h3>Ayurveda Wellness</h3>
                    <p>Holistic healing for mind, body and spirit</p>
                </div>
                <div class="footer-links">
                    <ul>
                        <li><a href="/about">About Us</a></li>
                        <li><a href="/services">Services</a></li>
                        <li><a href="/practitioners">Practitioners</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-social">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 Ayurveda Wellness Center. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Update hidden fields before submission
            const form = document.getElementById('consultationForm');
            if (form) {
                form.addEventListener('submit', function(e) {
                    // Get selected doctor
                    const doctorRadio = document.querySelector('.doctor-checkbox:checked');
                    if (doctorRadio) {
                        document.getElementById('selectedDoctor').value = doctorRadio.value;
                    }
                    
                    // Get selected consultation type
                    const consultationRadio = document.querySelector('.consultation-checkbox:checked');
                    if (consultationRadio) {
                        document.getElementById('consultationTypeHidden').value = consultationRadio.value;
                    }
                    
                    // Validate selections
                    if (!doctorRadio || !consultationRadio) {
                        e.preventDefault();
                        alert('Please select both a doctor and consultation type');
                        return false;
                    }
                    
                    return true;
                });
            }

            // Add click handlers for doctor cards
            document.querySelectorAll('.doctor-card').forEach(card => {
                card.addEventListener('click', function(e) {
                    if (e.target.tagName === 'INPUT' || e.target.tagName === 'LABEL' || 
                        e.target.tagName === 'BUTTON' || e.target.closest('button')) {
                        return;
                    }
                    
                    const radio = this.querySelector('.doctor-checkbox');
                    if (radio) {
                        radio.checked = true;
                        this.classList.add('selected');
                        
                        // Remove selected class from other cards
                        document.querySelectorAll('.doctor-card').forEach(otherCard => {
                            if (otherCard !== this) {
                                otherCard.classList.remove('selected');
                            }
                        });
                    }
                });
            });

            // Add click handlers for consultation cards
            document.querySelectorAll('.consultation-card').forEach(card => {
                card.addEventListener('click', function(e) {
                    if (e.target.tagName === 'INPUT' || e.target.tagName === 'LABEL') {
                        return;
                    }
                    
                    const radio = this.querySelector('.consultation-checkbox');
                    if (radio) {
                        radio.checked = true;
                        this.classList.add('selected');
                        
                        // Remove selected class from other cards
                        document.querySelectorAll('.consultation-card').forEach(otherCard => {
                            if (otherCard !== this) {
                                otherCard.classList.remove('selected');
                            }
                        });
                    }
                });
            });
        });
    </script>
</body>

</html>
