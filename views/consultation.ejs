<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ayurvedic Consultation | Wellness Center</title>
    <link rel="stylesheet" href="/css/consultation.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>

    <div class="header">
        <!-- DEBUG OUTPUT -->
      
    
        <%- include('partials/nav') %>
        <div class="login-register">
            <% if (user) { %>
                <span class="welcome-text">Welcome, <%= user.name %>!</span>
                <a href="/logout" class="btn-logout">Logout</a>
            <% } else { %>
                <a href="#" data-bs-toggle="modal" data-bs-target="#loginModal" class="btn-login">Login</a>
                <a href="/register" class="btn-register">Register</a>
            <% } %>
        </div>  
    </div>

    <div class="hero-section">
        <div class="container">
            <div class="hero-content">
                <h1>Personalized Ayurvedic Consultation</h1>
                <p class="lead">Experience holistic healing with our certified Ayurvedic practitioners</p>
            </div>
        </div>
    </div>

    <!-- Login Modal -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">Login to Your Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/login" method="POST">
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label">Email address</label>
                            <input type="email" class="form-control" id="loginEmail" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="loginPassword" class="form-label">Password</label>
                            <input type="password" class="form-control" id="loginPassword" name="password" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Login</button>
                    </form>
                    <div class="text-center mt-3">
                        <p>Don't have an account? <a href="/register" class="text-decoration-none">Register here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container consultation-container">
        <% if (error) { %>
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>
                <%= error %>
            </div>
        <% } %>

        <form id="consultationForm" action="/consultation/book" method="POST">
            <div class="row g-4">
                <!-- Left Section: Consultation Types -->
                <div class="col-lg-4">
                    <div class="consultation-section">
                        <h2 class="section-title"><i class="fas fa-spa me-2"></i>Consultation Types</h2>
                        <div class="section-description">Select the type of consultation that matches your needs</div>
                        
                        <div class="consultation-options">
                            <% const consultationTypes = [
                                { name: "General Consultation", price: 50, icon: "user-md", description: "Comprehensive health assessment and lifestyle recommendations" },
                                { name: "Eye Consultation", price: 60, icon: "eye", description: "Specialized care for eye health and vision improvement" },
                                { name: "Skin Consultation", price: 70, icon: "hand-holding-medical", description: "Natural solutions for skin conditions and beauty" }
                            ]; %>
                            
                            <% consultationTypes.forEach((type, index) => { %>
                                <div class="consultation-card">
                                    <div class="consultation-icon">
                                        <i class="fas fa-<%= type.icon %>"></i>
                                    </div>
                                    <div class="consultation-details">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <h5 class="consultation-name"><%= type.name %></h5>
                                            <span class="consultation-price">$<%= type.price %></span>
                                        </div>
                                        <p class="consultation-description"><%= type.description %></p>
                                        <div class="form-check">
                                            <input class="form-check-input consultation-radio" type="radio" 
                                                   name="consultationType" 
                                                   value="<%= type.name %>" 
                                                   id="consultationType-<%= index %>" 
                                                   data-price="<%= type.price %>" 
                                                   required
                                                   <%= formData && formData.consultationType === type.name ? 'checked' : '' %>>
                                            <label class="form-check-label" for="consultationType-<%= index %>">
                                                Select this option
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>

                <!-- Middle Section: Booking Form -->
                <div class="col-lg-4">
                    <div class="booking-section">
                        <h2 class="section-title"><i class="fas fa-calendar-check me-2"></i>Appointment Details</h2>
                        
                        <% if (!user) { %>
                            <div class="alert alert-warning d-flex align-items-center">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                <div>You are not signed in. <a href="/login" class="alert-link">Sign in</a> or fill in the details below.</div>
                            </div>
                        <% } else { %>
                            <div class="alert alert-success d-flex align-items-center">
                                <i class="fas fa-check-circle me-2"></i>
                                <div>Signed in as <strong><%= user.name %></strong>.</div>
                            </div>
                        <% } %>

                        <div class="booking-form">
                            <% if (!user) { %>
                                <div class="mb-3">
                                    <label for="patientName" class="form-label">Full Name</label>
                                    <input type="text" class="form-control" id="patientName" name="patientName" 
                                           value="<%= formData ? formData.patientName : '' %>" required>
                                </div>
                                <div class="mb-3">
                                    <label for="patientEmail" class="form-label">Email Address</label>
                                    <input type="email" class="form-control" id="patientEmail" name="patientEmail"
                                           value="<%= formData ? formData.patientEmail : '' %>" required>
                                </div>
                            <% } else { %>
                                <input type="hidden" name="patientName" value="<%= user.name %>">
                                <input type="hidden" name="patientEmail" value="<%= user.email %>">
                            <% } %>
                            
                            <div class="mb-3">
                                <label for="patientPhone" class="form-label">Phone Number</label>
                                <input type="tel" class="form-control" id="patientPhone" name="patientPhone"
                                       value="<%= formData ? formData.patientPhone : '' %>" required>
                            </div>
                            <div class="mb-3">
                                <label for="patientDOB" class="form-label">Date of Birth</label>
                                <input type="date" class="form-control" id="patientDOB" name="patientDOB"
                                       value="<%= formData ? formData.patientDOB : '' %>" required>
                            </div>
                            <div class="mb-3">
                                <label for="healthConcerns" class="form-label">Health Concerns</label>
                                <textarea class="form-control" id="healthConcerns" name="healthConcerns" rows="3" required
                                          placeholder="Describe your health concerns (minimum 20 characters)..."><%= formData ? formData.healthConcerns : '' %></textarea>
                            </div>
                            <div class="mb-3">
                                <label for="appointmentDateTime" class="form-label">Preferred Date & Time</label>
                                <input type="datetime-local" class="form-control" id="appointmentDateTime" 
                                       name="appointmentDateTime"
                                       value="<%= formData ? formData.appointmentDateTime : '' %>" required>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Section: Available Doctors -->
                <div class="col-lg-4">
                    <div class="doctors-section">
                        <h2 class="section-title"><i class="fas fa-user-md me-2"></i>Our Practitioners</h2>
                        <div class="section-description">Select your preferred Ayurvedic doctor</div>

                        <% if (approvedDoctors && approvedDoctors.length > 0) { %>
                            <div class="doctor-list">
                                <% approvedDoctors.forEach((doctor) => { %>
                                    <div class="doctor-card" data-doctor-id="<%= doctor._id %>">
                                        <div class="doctor-image">
                                            <img src="/image/<%= doctor.image %>" alt="Dr. <%= doctor.fullName %>" class="img-fluid">
                                        </div>
                                        <div class="doctor-info">
                                            <div class="form-check">
                                                <input type="radio" name="doctor" value="<%= doctor._id %>" 
                                                       class="form-check-input doctor-radio" 
                                                       id="doctor-<%= doctor._id %>" 
                                                       required
                                                       <%= formData && formData.doctor == doctor._id.toString() ? 'checked' : '' %>>
                                                <label class="form-check-label" for="doctor-<%= doctor._id %>"></label>
                                            </div>
                                            <h5 class="doctor-name">Dr. <%= doctor.fullName %></h5>
                                            <div class="doctor-specialty">
                                                <% if (doctor.educationQualification && doctor.educationQualification.length > 0) { %>
                                                    <i class="fas fa-graduation-cap"></i> <%= doctor.educationQualification.join(', ') %>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle me-2"></i> No doctors available at the moment. Please check back later.
                            </div>
                        <% } %>

                        <!-- Order Summary Section -->
                        <div class="order-summary mt-4">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="fas fa-receipt me-2"></i>Order Summary</h5>
                                </div>
                                <div class="card-body">
                                    <div id="consultationSummary" class="mb-2">
                                        <small class="text-muted">No consultation selected</small>
                                    </div>
                                    <div id="doctorSummary" class="mb-3">
                                        <small class="text-muted">No doctor selected</small>
                                    </div>
                                    <hr>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <h6>Total Amount:</h6>
                                        <h5 id="totalAmount">$0</h5>
                                        <input type="hidden" name="total_amount" id="totalAmountHidden" value="0">
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 mt-3 btn-book">
                                        <i class="fas fa-credit-card me-2"></i>Proceed to Payment
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-logo">
                    <h3>Ayurveda Wellness</h3>
                    <p>Holistic healing for mind, body and spirit</p>
                </div>
                <div class="footer-links">
                    <ul>
                        <li><a href="/about">About Us</a></li>
                        <li><a href="/services">Services</a></li>
                        <li><a href="/practitioners">Practitioners</a></li>
                        <li><a href="/contact">Contact</a></li>
                    </ul>
                </div>
                <div class="footer-social">
                    <a href="#"><i class="fab fa-facebook-f"></i></a>
                    <a href="#"><i class="fab fa-twitter"></i></a>
                    <a href="#"><i class="fab fa-instagram"></i></a>
                    <a href="#"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2025 Ayurveda Wellness Center. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Update summary when selections change
            function updateSummary() {
                const consultationRadio = document.querySelector('.consultation-radio:checked');
                const doctorRadio = document.querySelector('.doctor-radio:checked');
                
                // Update consultation summary
                if (consultationRadio) {
                    const consultationName = consultationRadio.value;
                    const consultationPrice = consultationRadio.dataset.price;
                    document.getElementById('consultationSummary').innerHTML = 
                        `<strong>Consultation:</strong> ${consultationName}<br>
                         <span class="text-muted">$${consultationPrice}</span>`;
                } else {
                    document.getElementById('consultationSummary').innerHTML = 
                        '<small class="text-muted">No consultation selected</small>';
                }
                
                // Update doctor summary
                if (doctorRadio) {
                    const doctorCard = doctorRadio.closest('.doctor-card');
                    const doctorName = doctorCard.querySelector('.doctor-name').textContent;
                    document.getElementById('doctorSummary').innerHTML = 
                        `<strong>Doctor:</strong> ${doctorName}`;
                } else {
                    document.getElementById('doctorSummary').innerHTML = 
                        '<small class="text-muted">No doctor selected</small>';
                }
                
                // Calculate and update total
                if (consultationRadio) {
                    const total = consultationRadio.dataset.price;
                    document.getElementById('totalAmount').textContent = `$${total}`;
                    document.getElementById('totalAmountHidden').value = total;
                } else {
                    document.getElementById('totalAmount').textContent = '$0';
                    document.getElementById('totalAmountHidden').value = '0';
                }
            }
            
            // Add event listeners for all radio buttons
            document.querySelectorAll('.consultation-radio, .doctor-radio').forEach(radio => {
                radio.addEventListener('change', updateSummary);
            });
            
            // Card click handlers
            document.querySelectorAll('.doctor-card, .consultation-card').forEach(card => {
                card.addEventListener('click', function(e) {
                    // Don't trigger if clicking directly on the radio or label
                    if (e.target.tagName === 'INPUT' || e.target.tagName === 'LABEL') return;
                    
                    const radio = this.querySelector('input[type="radio"]');
                    if (radio) {
                        radio.checked = true;
                        radio.dispatchEvent(new Event('change'));
                    }
                });
            });
            
            // Initial summary update
            updateSummary();
        });
    </script>
</body>
</html>