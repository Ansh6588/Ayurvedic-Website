<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ayurvedic Consultation</title>
    <link rel="stylesheet" href="css/consultation.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
</head>

<body>
    <div class="header">
        <%- include('partials/nav') %>
        <div class="login-register">
            <% if (user) { %>
                <span>Welcome, <%= user.name %>!</span>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="#" data-bs-toggle="modal" data-bs-target="#loginModal">Login</a>
                <a href="register">Register</a>
            <% } %>
        </div>  
    </div>
    <header class="text-center">
        <h1>Book Your Ayurvedic Consultation</h1>
        <p>Find the right consultation for your needs</p>
    </header>
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="loginModalLabel">Login</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="/login" method="POST">
                        <div class="mb-3">
                            <label for="loginEmail" class="form-label">Email address</label>
                            <input type="email" class="form-control" id="loginEmail" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="loginPassword" class="form-label">Password</label>
                            <input type="password" class="form-control" id="loginPassword" name="password" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Login</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <div class="container mt-4">
        <div class="row">
            <!-- Left Section: Consultation Types -->
            <div class="col-md-4">
                <h4 class="mb-4">Consultation Types</h4>
                <% let consultationTypes = [
                    { name: "General Consultation", price: 50 },
                    { name: "Eye Consultation", price: 60 },
                    { name: "Skin Consultation", price: 70 }
                ]; %>

                <% consultationTypes.forEach((type, index) => { %>
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">
                                <input type="checkbox" name="consultationType" value="<%= type.name %>" class="consultation-checkbox">
                                <%= type.name %>
                            </h5>
                            <p class="card-text">Price: $<%= type.price %></p>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Middle Section: Booking Form (Show only if not signed in) -->
            <div class="col-md-4">
                <h4 class="mb-4">Fill in Your Details</h4>

                <% if (!userName) { %>
                    <div class="alert alert-warning">
                        You are not signed in. <a href="/login">Sign in</a> or fill in the details below.
                    </div>

                    <form action="/book-consultation" method="POST">
                        <div class="mb-3">
                            <label for="full-name" class="form-label">Full Name:</label>
                            <input type="text" class="form-control" id="full-name" name="full_name" required>
                        </div>
                        <div class="mb-3">
                            <label for="email" class="form-label">Email:</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        <div class="mb-3">
                            <label for="phone" class="form-label">Phone Number:</label>
                            <input type="tel" class="form-control" id="phone" name="phone" required>
                        </div>
                        <div class="mb-3">
                            <label for="dob" class="form-label">Date of Birth:</label>
                            <input type="date" class="form-control" id="dob" name="dob" required>
                        </div>
                        <div class="mb-3">
                            <label for="concerns" class="form-label">Health Concerns:</label>
                            <textarea class="form-control" id="concerns" name="concerns" rows="3" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="appointment" class="form-label">Preferred Appointment Date & Time:</label>
                            <input type="datetime-local" class="form-control" id="appointment" name="appointment" required>
                        </div>
                        <button type="submit" class="btn btn-success w-100">Book Consultation</button>
                    </form>
                <% } else { %>
                    <div class="alert alert-success">
                        Signed in as <strong><%= userName %></strong>.
                    </div>
                <% } %>
            </div>

            <!-- Right Section: Available Doctors -->
            <div class="col-md-4">
                <h4 class="mb-4">Available Doctors</h4>

                <% if (approvedDoctors && approvedDoctors.length > 0) { %>
                    <% approvedDoctors.forEach((doctor) => { %>
                        <div class="card mb-3 doctor-card" data-doctor-id="<%= doctor._id %>">
                            <div class="card-body">
                                <input type="checkbox" name="doctor" value="<%= doctor._id %>" class="doctor-checkbox">
                                <img src="/image/<%= doctor.image %>" alt="Doctor Image" style="width: 150px; height: 150px;">
                                <h5 class="card-title mt-3"><%= doctor.fullName %></h5>
                                <p class="card-text">
                                    <strong>Education:</strong> <%= doctor.educationQualification.join(', ') %><br>
                                </p>
                                <div class="d-flex justify-content-between">
                                    <div>                                        
                                            <i class="fas fa-phone-alt"></i> Call
                                        </a>                                   
                                            <i class="fas fa-video"></i> Video Call
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p>No doctors available at the moment.</p>
                <% } %>
            </div>
        </div>
    </div>

    <footer class="text-center py-4 bg-light mt-5">
        <p>&copy; 2025 Ayurveda Wellness. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".doctor-card").forEach(card => {
        card.addEventListener("click", function (event) {
            // Prevent toggling if the user directly clicks on the checkbox
            if (event.target.tagName === "INPUT") return;

            const checkbox = this.querySelector(".doctor-checkbox");
            checkbox.checked = !checkbox.checked;
        });
    });

    // Prevent click from propagating when directly clicking the checkbox
    document.querySelectorAll(".doctor-checkbox").forEach(checkbox => {
        checkbox.addEventListener("click", function (event) {
            event.stopPropagation();  // Stop the event from reaching the card
        });
    });
});

</script>
</body>

</html>
