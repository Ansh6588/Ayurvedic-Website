<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payment Page</title>
    <link rel="stylesheet" href="css/payment.css">
</head>
<body>
    <div class="payment-container">
        <div class="payment-card">
            <h1>Payment Information</h1>
            <form action="/payment-success" method="POST">
                <!-- Card Information Section -->
                <div class="card-info">
                    <label for="card">Card Information:</label>
                    <div class="card-details">
                        <input type="radio" name="card" id="visa" checked>
                        <label for="visa" class="card-label">Visa <span class="card-type">(**** 1234)</span></label>
                    </div>
                </div>

                <!-- Amount Section -->
                <div class="amount">
                    <h2>Total: <span>$99.99</span></h2>
                </div>

                <!-- Pay Button -->
                <div class="pay-button-container">
                    <button type="submit" class="pay-button">Pay Now</button>
                </div>
            </form>
        </div>
    </div>
</body>
</html>
